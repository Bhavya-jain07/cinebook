# Copy to .env and fill in your own values

MONGO_URL=mongodb://localhost:27017/ticket-booking
JWT_SECRET=change-this-to-a-long-random-string

# Upstash Redis — from the Upstash console, use the "ioredis" / TCP
# connection string (looks like rediss://default:xxxx@xxxx.upstash.io:6379),
# NOT the REST URL/token. TCP is required here because pub/sub (used for
# the live seat-map updates) needs a persistent connection, which the
# REST API can't provide.
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379

PORT=3002
CLIENT_URL=http://localhost:5173

# How many people can be actively selecting seats for one showtime at
# once before new arrivals go into the virtual waiting room. Keep this
# low (e.g. 2) to make the waiting room easy to demo with a couple of
# browser tabs; a real system would tune this much higher.
MAX_CONCURRENT_PER_SHOWTIME=3
